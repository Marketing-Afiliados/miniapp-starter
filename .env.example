# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL (for auth callbacks and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase key used exclusively by trusted webhook processing
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Hotmart webhook token sent in X-HOTMART-HOTTOK
HOTMART_HOTTOK=

# Optional fallback plan code when a Hotmart product has no provider_product_id mapping
HOTMART_DEFAULT_PLAN_CODE=
