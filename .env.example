# PUBLIC: Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PUBLIC: canonical production URL used for auth callbacks and metadata.
# Leave unset locally. Vercel Preview falls back to its automatic VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY: used exclusively by trusted webhook and reconciliation code
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY: token sent by Hotmart in X-HOTMART-HOTTOK
HOTMART_HOTTOK=

# SERVER-ONLY / optional: fallback when no provider_product_id matches
HOTMART_DEFAULT_PLAN_CODE=

# SERVER-ONLY / optional: enables product access without a subscription.
# For a temporary Production QA, set true, redeploy, test, then remove it.
# Never leave enabled when normal production users enter the application.
DECOQUOTE_DEV_ACCESS=
