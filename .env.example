# PUBLIC: Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PUBLIC: canonical production URL used for auth callbacks and metadata.
# Leave unset locally. Vercel Preview falls back to its automatic VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY: used exclusively by trusted webhook and reconciliation code
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY: token sent by Hotmart in X-HOTMART-HOTTOK
HOTMART_HOTTOK=

# SERVER-ONLY / optional legacy fallback for payloads without provider references
HOTMART_DEFAULT_PLAN_CODE=

# SERVER-ONLY: one-time purchase webhook. Use separate Supabase projects for test/production.
# Must match payment_settings.environment in the database.
HOTMART_ENVIRONMENT=test

# Public destinations read on the server. Set the REAL one-time Hotmart URL.
HOTMART_CHECKOUT_URL=https://pay.hotmart.com/Y107492007M?off=ij6szo4g
DECOQUOTE_TERMS_URL=

# Checkout enabled by the product owner; false remains an emergency sales switch.
# This flag controls new sales, not existing access or refund reception.
HOTMART_ONE_TIME_ENABLED=true
